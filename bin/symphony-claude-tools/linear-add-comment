#!/usr/bin/env bash
#
# linear-add-comment — Post a comment on a Linear issue.
#
# Usage:
#   linear-add-comment --id <issue-id> --body "<text>"
#
# Exit codes match linear-graphql.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: linear-add-comment --id <id> --body "<text>"

Post a comment on a Linear issue.

  --id    <id>    Linear issue UUID (required).
  --body  <text>  Comment body (required).
  --help          Show this help.
EOF
}

issue_id=""
body=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --id)   issue_id="${2:-}"; shift 2 ;;
    --body) body="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -z "$issue_id" ]]; then
  echo "--id is required." >&2; usage >&2; exit 2
fi

if [[ -z "$body" ]]; then
  echo "--body is required." >&2; usage >&2; exit 2
fi

mutation='mutation($input: CommentCreateInput!) { commentCreate(input: $input) { success comment { id body createdAt } } }'
vars=$(jq -n --arg id "$issue_id" --arg body "$body" '{input: {issueId: $id, body: $body}}')

"$(dirname "$0")/linear-graphql" --query "$mutation" --vars "$vars"
