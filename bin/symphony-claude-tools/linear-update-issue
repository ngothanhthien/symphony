#!/usr/bin/env bash
#
# linear-update-issue — Update a Linear issue's state, assignee, or title.
#
# Usage:
#   linear-update-issue --id <issue-id> [--state <state-name>] [--assignee <user-id-or-email>] [--title <text>]
#
# At least one of --state, --assignee, or --title must be provided.
#
# Exit codes match linear-graphql.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: linear-update-issue --id <id> [--state <name>] [--assignee <user>] [--title <text>']

Update a Linear issue. At least one of --state/--assignee/--title is required.

  --id        <id>     Linear issue UUID (required).
  --state     <name>   Workflow state name (e.g. "In Progress", "Done").
  --assignee  <user>   User id, email, or "me".
  --title     <text>   New issue title.
  --help                Show this help.
EOF
}

issue_id=""
state_name=""
assignee=""
title=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --id)        issue_id="${2:-}"; shift 2 ;;
    --state)     state_name="${2:-}"; shift 2 ;;
    --assignee)  assignee="${2:-}"; shift 2 ;;
    --title)     title="${2:-}"; shift 2 ;;
    --help|-h)   usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -z "$issue_id" ]]; then
  echo "--id is required." >&2; usage >&2; exit 2
fi

if [[ -z "$state_name" && -z "$assignee" && -z "$title" ]]; then
  echo "At least one of --state, --assignee, or --title is required." >&2
  usage >&2
  exit 2
fi

# Build the input object for issueUpdate. Note: `id` is NOT part of the input
# payload — it goes on the mutation as a separate top-level argument. We
# only include the optional fields the caller actually supplied so a missing
# --state doesn't accidentally clear the issue's state.
input=$(jq -n \
  --arg state "$state_name" \
  --arg assignee "$assignee" \
  --arg title "$title" \
  '{}
   | if $state    != "" then .stateId    = $state    else . end
   | if $assignee != "" then .assigneeId = $assignee else . end
   | if $title    != "" then .title      = $title    else . end')

# Resolve --state to a stateId if a name was given (we look up team states).
# Skip this resolution if state looks like a UUID already.
if [[ -n "$state_name" && ! "$state_name" =~ ^[0-9a-f-]{36}$ ]]; then
  # Fetch the issue's team, then list workflow states for that team, then find
  # the matching state by name. All in one GraphQL request.
  issue_query='query($id: String!) { issue(id: $id) { team { id name } } }'
  team_json=$(LINEAR_API_URL="${LINEAR_API_URL:-}" "$(dirname "$0")/linear-graphql" \
    --query "$issue_query" --vars "$(jq -n --arg id "$issue_id" '{id: $id}')")

  team_id=$(echo "$team_json" | jq -r '.issue.team.id // empty')
  if [[ -z "$team_id" ]]; then
    echo "Could not resolve team for issue $issue_id." >&2
    exit 5
  fi

  states_query='query($team: ID!) { workflowStates(filter: { team: { id: { eq: $team } } }) { nodes { id name type } } }'
  states_json=$(LINEAR_API_URL="${LINEAR_API_URL:-}" "$(dirname "$0")/linear-graphql" \
    --query "$states_query" --vars "$(jq -n --arg team "$team_id" '{team: $team}')")

  # Case-insensitive match on name.
  state_id=$(echo "$states_json" | jq -r --arg n "$state_name" \
    '.workflowStates.nodes | map(select(.name | ascii_downcase == ($n | ascii_downcase))) | .[0].id // empty')

  if [[ -z "$state_id" ]]; then
    echo "State '$state_name' not found in team $team_id. Available states:" >&2
    echo "$states_json" | jq -r '.workflowStates.nodes[].name' >&2
    exit 5
  fi

  # Replace the placeholder state name (if any) with the resolved state id.
  input=$(echo "$input" | jq --arg sid "$state_id" '.stateId = $sid')
fi

mutation='mutation($id: String!, $input: IssueUpdateInput!) { issueUpdate(id: $id, input: $input) { success issue { id identifier title state { name } } } }'
vars=$(jq -n --arg id "$issue_id" --argjson input "$input" '{id: $id, input: $input}')

"$(dirname "$0")/linear-graphql" --query "$mutation" --vars "$vars"
